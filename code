public int majorityElement(int[] nums) {
    int maj = nums[0];
    int n = nums.length;
    int c = 1;
    
    for (int i = 1; i < n; i++) {
        if (c == 0) {
            maj = nums[i];
            c = 1;
        } else if (maj == nums[i]) {
            c++;
        } else {
            c--;
        }
    }
    return maj;
}
